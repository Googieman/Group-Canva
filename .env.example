# Frontend build-time setting. Leave unset for the local same-origin server.
# VITE_SERVER_URL=https://your-group-canvas.onrender.com
# Hosted browser/benchmark targets (never commit deployed URLs as secrets).
# E2E_BASE_URL=https://your-group-canvas.pages.dev
# BENCH_FRONTEND_URL=https://your-group-canvas.pages.dev
# BENCH_SERVER_URL=https://your-group-canvas.onrender.com
# Backend environment (set in shell/hosting dashboard; Node does not auto-load this file).
# PORT=3000
# BACKEND_PORT=3000
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://your-group-canvas.pages.dev
# PERSISTENCE_PATH=./data/rooms.json
